    <!-- ARCHITECTURE SECTION -->
    <div class="section architecture-section" id="architecture">
        <div class="section-tag">Technical Foundation</div>
        <h2 class="section-title">Seven Core Modules</h2>

        <p style="font-size: 16px; color: var(--text-muted); margin-bottom: 40px;">Eklavya's architecture is built around seven interconnected modules, each handling a distinct function in the career intelligence pipeline.</p>

        <div class="architecture-grid">
            <div class="arch-box">
                <div class="arch-title">Authentication & Sessions</div>
                <div class="arch-items">
                    <div class="arch-item">Google OAuth 2.0</div>
